/* app.wxss 全局样式 */
page {
  --primary: #ff69b4;
  --primary-light: #ffd6ec;
  --bg: #fef6fb;
  --card: #ffffff;
  --text: #333333;
  --text-sub: #888888;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 105, 180, 0.08);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

.btn {
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  border: none;
}

.btn-ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
}

.muted {
  color: var(--text-sub);
  font-size: 24rpx;
}
