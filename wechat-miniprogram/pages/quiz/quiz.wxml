<!-- pages/quiz/quiz.wxml -->
<view class="container">
  <view class="progress">
    <text>第 {{current+1}} / {{total}} 题</text>
    <view class="bar"><view class="bar-inner" style="width:{{(current+1)/total*100}}%"></view></view>
  </view>

  <view class="card q-card">
    <view class="q-text">{{list[current].text}}</view>
  </view>

  <view class="card">
    <view class="opt-title">选择符合程度：</view>
    <view class="options">
      <view
        wx:for="{{options}}"
        wx:key="value"
        class="opt {{selected===item.value?'opt-active':''}}"
        data-v="{{item.value}}"
        bindtap="choose"
      >
        <view class="opt-color">{{item.color}}</view>
        <view class="opt-val">{{item.value}}分</view>
        <view class="opt-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="nav-row">
    <button class="btn-ghost nav-btn" bindtap="prev" wx:if="{{current>0}}">上一题</button>
    <button class="btn nav-btn {{current>0?'half':''}}" bindtap="next">
      {{current===total-1 ? '查看结果' : '下一题'}}
    </button>
  </view>
</view>
