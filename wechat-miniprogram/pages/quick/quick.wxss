/* pages/quick/quick.wxss */
.tip { background: linear-gradient(135deg, #eef4ff, #dcebff); }
.tip-title { font-weight: 700; font-size: 32rpx; margin-bottom: 8rpx; }
.hl { color: #3a7afe; font-weight: 700; }
.item {
  display: flex;
  align-items: center;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  background: #fafafa;
  margin-bottom: 14rpx;
  border: 2rpx solid transparent;
}
.item-on {
  background: #eef4ff;
  border-color: #3a7afe;
}
.item-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #dcebff;
  color: #3a7afe;
  font-weight: 700;
  text-align: center;
  line-height: 56rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
}
.item-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.5;
}
.item-check {
  width: 40rpx;
  text-align: center;
  color: #3a7afe;
  font-weight: 700;
}
