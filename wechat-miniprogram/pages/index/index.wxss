/* pages/index/index.wxss */
.hero {
  text-align: center;
  background: linear-gradient(135deg, #fff0f8, #ffe0f0);
}
.hero-emoji {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}
.field-label {
  font-size: 28rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}
.age-input {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}
.gender-row {
  display: flex;
  gap: 20rpx;
}
.gender-opt {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  background: #fafafa;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}
.gender-opt.active {
  background: #fff0f8;
  border-color: #ff69b4;
  color: #ff69b4;
  font-weight: 600;
}
